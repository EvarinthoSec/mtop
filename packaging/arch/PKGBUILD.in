pkgname=mtop
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Cross-platform terminal system monitor'
arch=('x86_64')
url='https://launchpad.net/mtop-monitor'
license=('MIT')
depends=('glibc')
makedepends=('cargo' 'git')
source=("mtop-${pkgver}.tar.gz::https://github.com/EvarinthoSec/mtop/archive/refs/tags/v@TAG_VERSION@.tar.gz")
sha256sums=('@SOURCE_SHA256@')

_source_root() {
    local manifests=("${srcdir}"/*/Cargo.toml)
    (( ${#manifests[@]} == 1 )) || return 1
    printf '%s' "${manifests[0]%/Cargo.toml}"
}

build() {
    cd "$(_source_root)"
    cargo build --locked --release --package mtop
}

package() {
    cd "$(_source_root)"
    install -Dm755 target/release/mtop "${pkgdir}/usr/bin/mtop"
    install -Dm644 packaging/mtop.1 "${pkgdir}/usr/share/man/man1/mtop.1"
    install -Dm644 packaging/mtop.desktop "${pkgdir}/usr/share/applications/mtop.desktop"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/mtop/LICENSE"
    install -Dm644 THIRD_PARTY_NOTICES.md "${pkgdir}/usr/share/licenses/mtop/THIRD_PARTY_NOTICES.md"
    install -Dm644 THIRD_PARTY_LICENSES/btop-Apache-2.0.txt \
        "${pkgdir}/usr/share/licenses/mtop/btop-Apache-2.0.txt"
}
